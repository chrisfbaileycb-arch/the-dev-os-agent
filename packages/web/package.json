{
  "name": "signal-forge-os-web",
  "description": "The Signal Forge OS web app and its Node server.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build",
    "preview": "node server/index.mjs",
    "test": "vitest run",
    "start": "node server/index.mjs",
    "test:server": "node --test tests/*.test.mjs",
    "worker": "node server/worker.mjs"
  },
  "dependencies": {
    "esbuild-wasm": "^0.28.2",
    "lucide-react": "^1.46.0",
    "pg": "^8.23.0",
    "playwright": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
