{
  "name": "Signal Forge OS",
  "short_name": "Signal Forge OS",
  "description": "Your AI crew in a browser tab. A privacy-first multi-agent workspace that runs on a Chromebook or any computer with a modern browser, with your own keys and no account.",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "lang": "en-US",
  "background_color": "#f7f9f7",
  "theme_color": "#111a16",
  "categories": ["productivity", "utilities"],
  "shortcuts": [
    { "name": "Chat", "short_name": "Chat", "url": "./?view=chat", "description": "Open chat" },
    { "name": "Crew", "short_name": "Crew", "url": "./?view=crew", "description": "Open the crew" },
    { "name": "Knowledge", "short_name": "Knowledge", "url": "./?view=knowledge", "description": "Open knowledge" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        { "name": "file", "accept": ["text/plain", "text/markdown", ".md", ".txt"] }
      ]
    }
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
