# Set these in your cloud hosting platform. Never commit real secrets.
PORT=4173
# Leave APP_ORIGIN unset on Render: the server matches the request Origin against its own Host,
# which is correct there. Set it only to pin one external origin; a wrong value makes every API
# call fail with 403.
# APP_ORIGIN=https://your-app.example
CUSTOM_API_ORIGINS=https://your-inference.example
# Optional administrator-approved Ollama or LM Studio bridge; includes /v1.
# OLLAMA_BRIDGE_URL=https://your-secure-ollama-bridge.example/v1

# Workspace store (sessions, runs, credit ledger, job queue). SQLite file; mount a persistent disk here.
DATA_DIR=./data
# DATA_FILE=/data/heybuddy.sqlite   # overrides DATA_DIR when set

# ---------------------------------------------------------------------------------------------
# Zero-config free tier
# ---------------------------------------------------------------------------------------------
# Set either key and a visitor with no account and no API key gets a live streaming reply on an
# allowlisted free model, funded by this deployment. Leave both unset and the app opens in the
# scripted preview and asks the visitor for their own key instead. Both providers offer free
# accounts, so this is usually the single most valuable variable to set.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# XKIRO_API_KEY=
#
# Which models this funds is a hard server-side allowlist in server/freetier.mjs:
#   groq/llama-3.3-70b-versatile, groq/llama-3.1-8b-instant,
#   openrouter/auto (pinned to the zero-cost pool), the three :free OpenRouter models,
#   and the xKiro gateway pool below. Keys stack: set several and the pools combine.
#
# xKiro (https://api.xkiro.com/v1) is a unified gateway fronting DeepSeek, GLM, Qwen, Kimi and
# others through one OpenAI-compatible endpoint. Unlike the fixed pools above, its catalogue is
# the gateway's to define, so the shipped ids are only a seed and this overrides them wholesale.
# Set it to whatever GET https://api.xkiro.com/v1/models actually returns — a wrong id then
# costs a dashboard edit rather than a redeploy. Blank uses the seed.
# XKIRO_FREE_MODELS=deepseek/deepseek-chat,deepseek-r1,glm-5.2,glm-5.3-flash
#
# Free credits per workspace per month, at 0.5 credits per 1,000 tokens (400 ≈ 800,000 tokens).
# Metered on the server from the bytes that actually streamed, so the browser cannot under-report.
FREE_CREDIT_MONTHLY_POOL=400
# Per-IP burst cap. The workspace id is minted by the browser and can be rotated, so this is what
# bounds how fast one network address can spend this deployment's provider keys.
FREE_MAX_PER_HOUR=40
# Output ceiling for a server-funded reply, whatever the browser asks for.
FREE_MAX_OUTPUT_TOKENS=1024
# Switch the tier off without removing the provider keys.
FREE_TIER_DISABLED=false

# Platform credits: the full model pool, unlocked by an administrator token rather than open to
# the public. Separate budget from the free tier above.
CREDIT_MONTHLY_POOL=100000
# SERVER_CREDIT_ACCESS_TOKEN=
# COHERE_API_KEY=
# CUSTOM_API_KEY=

# ---------------------------------------------------------------------------------------------
# Connectors
# ---------------------------------------------------------------------------------------------
# URL crawler (/api/fetch): a plain GET, no JavaScript, converted to text server-side so the
# browser can read external pages despite CORS. Open to any public host by default; set a
# comma-separated list to narrow it. Private and reserved addresses are always blocked.
# FETCH_ALLOWED_HOSTS=example.com,*.docs.example
FETCH_ALLOWED_HOSTS=
FETCH_MAX_PER_HOUR=60

# GitHub connector (/api/github): read-only repository and issue access. A server token is
# optional — visitors may paste their own in the Connectors hub. Without any token GitHub allows
# 60 calls an hour and public repositories only.
# GITHUB_TOKEN=
GITHUB_MAX_PER_HOUR=120

# Browser Agent (/api/browse): real Chromium, so it is locked to an explicit host allowlist.
# Empty disables it. "*" allows any public host.
# BROWSE_ALLOWED_HOSTS=*.example.com,competitor.example
BROWSE_ALLOWED_HOSTS=
BROWSE_MAX_PER_HOUR=30

# MCP connector (/api/mcp): calls per workspace per hour to remote MCP servers.
MCP_MAX_PER_HOUR=120

# ---------------------------------------------------------------------------------------------
# Background worker (optional second Render service)
# ---------------------------------------------------------------------------------------------
# Shared secret for /api/jobs/claim, /api/jobs/update, and /api/jobs/finish. Set the same value on
# both services. With no worker deployed this is unused and workflows run in the browser.
# WORKER_TOKEN=
# On the worker service only: the web service's internal address and poll interval.
# WEB_SERVICE_URL=http://hey-buddy-web:8080
# WORKER_POLL_MS=3000
