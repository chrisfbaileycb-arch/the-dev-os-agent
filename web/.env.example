# Set these in your cloud hosting platform. Never commit real secrets.
PORT=4173
APP_ORIGIN=https://your-app.example
CUSTOM_API_ORIGINS=https://your-inference.example
# Optional administrator-approved Ollama or LM Studio bridge; includes /v1.
# OLLAMA_BRIDGE_URL=https://your-secure-ollama-bridge.example/v1

# Workspace store (sessions, runs, credit ledger). SQLite file; mount a persistent disk here.
DATA_DIR=./data
# DATA_FILE=/data/heybuddy.sqlite   # overrides DATA_DIR when set
# Platform credits: monthly allowance per workspace, in credits (fast models 0.5/1K tokens, standard 3, reasoning 15).
CREDIT_MONTHLY_POOL=100000

# Browser Agent: hosts the sandbox browser may open. Empty disables it. "*" allows any public host.
# BROWSE_ALLOWED_HOSTS=*.example.com,competitor.example
BROWSE_ALLOWED_HOSTS=
BROWSE_MAX_PER_HOUR=30

# Platform credits route through these server keys, only for requests carrying the access token.
# Public users must supply their own keys.
# SERVER_CREDIT_ACCESS_TOKEN=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# COHERE_API_KEY=
# CUSTOM_API_KEY=
