# OLLAMA_BRIDGE_URL=http://localhost:11434/v1

# Optional server-funded access. Public users must supply their own keys.
# SERVER_CREDIT_ACCESS_TOKEN=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# COHERE_API_KEY=
# CUSTOM_API_KEY=
